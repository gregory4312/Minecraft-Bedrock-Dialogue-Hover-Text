{
  "name": "minecraft-dialogue-translator",
  "displayName": "Minecraft Bedrock Dialogue Hover Text",
  "description": "Translates dialogue keys in Minecraft Bedrock dialogue files",
  "version": "0.1.0",
  "publisher": "gregory4312",
  "repository": {
    "type": "git",
    "url": "https://github.com/gregory4312/minecraft-bedrock-dialogue-hover-text"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:BP/dialogues/**/*.json",
    "workspaceContains:behavior_packs/*/dialogues/**/*.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Minecraft Dialogue Translator",
      "properties": {
        "minecraftDialogueTranslator.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover tooltips for dialogue keys"
        },
        "minecraftDialogueTranslator.languageFile": {
          "type": "string",
          "default": "RP/texts/en_US.lang",
          "description": "Path to the language file relative to workspace root"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "14.x",
    "eslint": "^7.27.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "glob": "^7.1.7",
    "mocha": "^8.4.0",
    "typescript": "^4.3.2",
    "vscode-test": "^1.5.2"
  }
}